
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ART GALLERY</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#0f0f0f;
    font-family:Arial, sans-serif;
    color:white;
    overflow-x:hidden;
}

header{
    text-align:center;
    padding:30px 15px;
    font-size:32px;
    letter-spacing:4px;
    font-weight:bold;
}

.gallery{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:18px;
    padding:20px;
    max-width:1400px;
    margin:auto;
}

.gallery-item{
    position:relative;
    overflow:hidden;
    border-radius:18px;
    background:#1b1b1b;
    box-shadow:0 0 15px rgba(0,0,0,0.5);
    transition:0.4s;
}

.gallery-item:hover{
    transform:scale(1.02);
}

.gallery img{
    width:100%;
    height:320px;
    object-fit:cover;
    display:block;
    cursor:pointer;
    transition:0.4s;
}

.gallery img:hover{
    transform:scale(1.05);
}

.caption{
    padding:12px;
    text-align:center;
    font-size:15px;
    background:#151515;
}

/* FULLSCREEN VIEWER */

.viewer{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,0.95);
    display:none;
    justify-content:center;
    align-items:center;
    z-index:9999;
    padding:20px;
}

.viewer img{
    max-width:95%;
    max-height:90%;
    border-radius:14px;
}

.close{
    position:absolute;
    top:20px;
    right:25px;
    font-size:40px;
    color:white;
    cursor:pointer;
}

/* TOUCH MOBILE */

@media(max-width:768px){

.gallery img{
    height:240px;
}

header{
    font-size:24px;
}

}

</style>
</head>

<body>

<header>
ART & BOOKS GALLERY
</header>

<div class="gallery">

    <div class="gallery-item">
        <img src="image1.jpg" alt="Artwork 1">
        <div class="caption">Artwork One</div>
    </div>

    <div class="gallery-item">
        <img src="image2.jpg" alt="Artwork 2">
        <div class="caption">Artwork Two</div>
    </div>

    <div class="gallery-item">
        <img src="image3.jpg" alt="Artwork 3">
        <div class="caption">Artwork Three</div>
    </div>

    <div class="gallery-item">
        <img src="image4.jpg" alt="Artwork 4">
        <div class="caption">Artwork Four</div>
    </div>

</div>

<!-- FULLSCREEN -->

<div class="viewer" id="viewer">
    <span class="close" id="close">&times;</span>
    <img id="viewer-img" src="">
</div>

<script>

const images = document.querySelectorAll('.gallery img');
const viewer = document.getElementById('viewer');
const viewerImg = document.getElementById('viewer-img');
const closeBtn = document.getElementById('close');

images.forEach(img => {

    img.addEventListener('click', () => {
        viewer.style.display = 'flex';
        viewerImg.src = img.src;
    });

});

closeBtn.addEventListener('click', () => {
    viewer.style.display = 'none';
});

viewer.addEventListener('click', (e) => {

    if(e.target !== viewerImg){
        viewer.style.display = 'none';
    }

});

</script>

</body>
</html>
